# --- LLM ---
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=2000
LLM_TIMEOUT=120

# --- Извлечение текста (гибридная схема) ---
# Минимум символов, чтобы текст считался достаточным для отправки в LLM.
PDF_MIN_CHARS=300
# Локальный OCR для скан-документов (нужна системная зависимость tesseract-ocr + язык).
OCR_ENABLED=true
OCR_LANG=rus
MAX_PAGES=50
# Сколько страниц-картинок отдавать в мультимодальную модель, если OCR не сработал.
MEDIA_MAX_IMAGES=5

# --- Прочее ---
# Способ обработки по умолчанию: local (текст) или cloud (медиа в модель).
ANALYSIS_MODE=local
MAX_FILE_SIZE_MB=25
PROMPT_FILE=app/prompts/extract.md
# LOG_LEVEL=DEBUG — включить подробные логи.
LOG_LEVEL=INFO
